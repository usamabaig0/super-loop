#!/usr/bin/env bash
# super-loop: Unified autonomous pipeline combining Grill-Me, GSD Core, and Ralph.
# Based on: https://github.com/open-gsd/gsd-core & https://github.com/snarktank/ralph

set -euo pipefail

VERSION="1.2.0"
DEFAULT_ITERATIONS=15
TOOL="${AI_TOOL:-}"
MODEL="${AI_MODEL:-}"
RALPH_SCAFFOLD="${RALPH_HOME:-$HOME/.ralph}"

# Auto-detect AI tool if not specified
if [ -z "$TOOL" ]; then
  if command -v agy &>/dev/null; then
    TOOL="agy"
  elif command -v claude &>/dev/null; then
    TOOL="claude"
  elif command -v codex &>/dev/null; then
    TOOL="codex"
  elif command -v opencode &>/dev/null; then
    TOOL="opencode"
  elif command -v amp &>/dev/null; then
    TOOL="amp"
  else
    TOOL="agy"
  fi
fi

show_help() {
  cat << 'EOF'
super-loop: Generalized Autonomous Pipeline (Grill-Me + GSD Core + Ralph)

Usage:
  super-loop "<feature description>"       Initialize and plan a feature through the pipeline
  super-loop --run [max_iterations]        Execute Ralph autonomous loop on existing prd.json
  super-loop --status                      Check progress of current run
  super-loop --verify                      Run verification gates on completed work
  super-loop -h, --help                    Show this help message
  super-loop -v, --version                 Show version

Options:
  --tool <agy|claude|codex|opencode|amp>   Specify the AI CLI runner (default: auto-detected)
  --model <model_name>                     Model flag passed to AI CLI runner
  --iterations <N>                         Maximum loop iterations (default: 15)

Environment Variables:
  AI_TOOL                                  Default AI CLI tool runner
  AI_MODEL                                 Default model string
  RALPH_HOME                               Custom path to Ralph global template directory (default: ~/.ralph)

Pipeline Stages:
  1. Grill-Me:         Adversarial design stress-testing & scope definition
  2. GSD Planning:     Phase plan architecture & boundary specification
  3. Ralph Loop:       Headless fresh-context iterations executing stories in prd.json
  4. GSD Verification: Quality gates, typechecks, tests, and branch readiness
EOF
}

check_dependencies() {
  if ! command -v jq &>/dev/null; then
    echo "Error: 'jq' command-line JSON processor is required by super-loop."
    echo "Please install jq (e.g. 'sudo apt install jq' or 'brew install jq')."
    exit 1
  fi
}

cmd_status() {
  check_dependencies
  local prd_file="scripts/ralph/prd.json"
  [ ! -f "$prd_file" ] && [ -f "prd.json" ] && prd_file="prd.json"

  if [ ! -f "$prd_file" ]; then
    echo "No prd.json found in ./scripts/ralph or current directory."
    exit 1
  fi

  local project
  local branch
  project=$(jq -r '.project // "Unknown"' "$prd_file")
  branch=$(jq -r '.branchName // "main"' "$prd_file")
  local total
  local passed
  total=$(jq '.userStories | length' "$prd_file")
  passed=$(jq '[.userStories[] | select(.passes == true)] | length' "$prd_file")

  echo "==============================================================="
  echo "  Super-Loop Status: $project"
  echo "  Branch: $branch | Completed: $passed / $total stories"
  echo "==============================================================="
  echo ""
  jq -r '.userStories[] | "  [" + (if .passes then "✓" else " " end) + "] " + .id + ": " + .title' "$prd_file"
  echo ""

  local progress_file="scripts/ralph/progress.txt"
  [ ! -f "$progress_file" ] && [ -f "progress.txt" ] && progress_file="progress.txt"
  if [ -f "$progress_file" ]; then
    echo "Recent Progress Log:"
    tail -n 12 "$progress_file"
  fi
}

cmd_verify() {
  echo "Running Super-Loop verification gates..."
  if command -v gsd-tools &>/dev/null; then
    echo "Running gsd-tools check..."
    gsd-tools check || true
  fi

  if [ -f "package.json" ]; then
    echo "Running project typecheck/test verification..."
    if command -v jq &>/dev/null && jq -e '.scripts.typecheck' package.json >/dev/null 2>&1; then
      npm run typecheck || true
    fi
    if command -v jq &>/dev/null && jq -e '.scripts.test' package.json >/dev/null 2>&1; then
      npm test || true
    fi
  fi

  if [ -f "pytest.ini" ] || [ -f "pyproject.toml" ] || [ -f "setup.py" ]; then
    if command -v pytest &>/dev/null; then
      echo "Running pytest test suite..."
      pytest -q || true
    fi
  fi
  echo "Verification complete."
}

create_fallback_ralph_runner() {
  local target_dir="scripts/ralph"
  mkdir -p "$target_dir"

  if [ ! -f "$target_dir/ralph.sh" ]; then
    cat > "$target_dir/ralph.sh" << 'RUNNER_EOF'
#!/usr/bin/env bash
set -euo pipefail

TOOL="${1:-agy}"
MAX_ITERS="${2:-15}"

if [ "$TOOL" = "--tool" ]; then
  shift
  TOOL="${1:-agy}"
  shift
  MAX_ITERS="${1:-15}"
fi

PROMPT_FILE="prompt.md"
PRD_FILE="prd.json"
PROGRESS_FILE="progress.txt"

[ ! -f "$PROMPT_FILE" ] && echo "Missing $PROMPT_FILE" && exit 1
[ ! -f "$PRD_FILE" ] && echo "Missing $PRD_FILE" && exit 1

echo "Starting Ralph runner with $TOOL ($MAX_ITERS iterations)..."
for i in $(seq 1 "$MAX_ITERS"); do
  ALL_PASSED=$(jq '[.userStories[] | select(.passes == false)] | length' "$PRD_FILE")
  if [ "$ALL_PASSED" -eq 0 ]; then
    echo "All user stories passed!"
    break
  fi
  echo "Iteration $i of $MAX_ITERS..."
  case "$TOOL" in
    agy)
      agy --prompt-file "$PROMPT_FILE" || true
      ;;
    claude)
      claude -p "$(cat "$PROMPT_FILE")" || true
      ;;
    codex)
      codex exec "$(cat "$PROMPT_FILE")" || true
      ;;
    opencode)
      opencode run "$(cat "$PROMPT_FILE")" || true
      ;;
    *)
      if command -v "$TOOL" &>/dev/null; then
        "$TOOL" "$(cat "$PROMPT_FILE")" || true
      else
        echo "Tool $TOOL not executable."
        exit 1
      fi
      ;;
  esac
done
RUNNER_EOF
    chmod +x "$target_dir/ralph.sh"
  fi
}

cmd_run() {
  local max_iters="${1:-$DEFAULT_ITERATIONS}"
  local ralph_script="scripts/ralph/ralph.sh"
  [ ! -f "$ralph_script" ] && [ -f "ralph.sh" ] && ralph_script="./ralph.sh"

  if [ ! -f "$ralph_script" ]; then
    echo "scripts/ralph/ralph.sh not found. Generating default Ralph runner..."
    create_fallback_ralph_runner
    ralph_script="scripts/ralph/ralph.sh"
  fi

  echo "Starting Ralph headless execution loop ($max_iters iterations, tool: $TOOL)..."
  if [ "$ralph_script" = "scripts/ralph/ralph.sh" ]; then
    (cd scripts/ralph && ./ralph.sh --tool "$TOOL" "$max_iters")
  else
    "$ralph_script" --tool "$TOOL" ${MODEL:+--model "$MODEL"} "$max_iters"
  fi

  echo ""
  echo "Loop finished. Running verification..."
  cmd_verify
}

cmd_init() {
  local feature="$1"
  check_dependencies

  echo "==============================================================="
  echo "  Super-Loop: Initializing pipeline for feature"
  echo "==============================================================="
  echo "Feature: $feature"
  echo ""

  # 1. Initialize Ralph directory with portable scaffold
  mkdir -p scripts/ralph
  if [ -d "$RALPH_SCAFFOLD" ]; then
    cp -r "$RALPH_SCAFFOLD"/* scripts/ralph/ 2>/dev/null || true
  elif command -v ralph &>/dev/null; then
    ralph init scripts/ralph >/dev/null || true
  else
    create_fallback_ralph_runner
  fi
  echo "✓ Scaffolding established in scripts/ralph/"

  # 2. Format a branch name
  local branch_slug
  branch_slug=$(echo "$feature" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g' | sed -E 's/^-+|-+$//g' | cut -c 1-30)
  [ -z "$branch_slug" ] && branch_slug="feature"
  local branch_name="ralph/$branch_slug"

  # 3. Create or update prd.json with feature
  local prd_file="scripts/ralph/prd.json"
  local needs_init=false
  if [ ! -f "$prd_file" ]; then
    needs_init=true
  elif grep -q "Example Project" "$prd_file" 2>/dev/null || grep -q '"project": "MyApp"' "$prd_file" 2>/dev/null || grep -q '"project": ""' "$prd_file" 2>/dev/null; then
    needs_init=true
  fi

  if [ "$needs_init" = true ]; then
    cat > "$prd_file" << EOF
{
  "project": $(jq -n --arg f "$feature" '$f'),
  "branchName": "$branch_name",
  "description": $(jq -n --arg f "$feature" '$f'),
  "userStories": [
    {
      "id": "US-001",
      "title": "Initial architecture & setup for $feature",
      "description": "As a developer, I want the foundational scaffold and interfaces in place so that the feature can be implemented cleanly.",
      "acceptanceCriteria": [
        "Core structures, types, or models created",
        "Project builds and typechecks without errors"
      ],
      "priority": 1,
      "passes": false,
      "notes": "Generated by super-loop"
    },
    {
      "id": "US-002",
      "title": "Core functionality for $feature",
      "description": "As a user, I want the primary capability functional and verified with unit tests.",
      "acceptanceCriteria": [
        "Core domain logic and API implemented",
        "Automated unit tests covering happy path and edge cases pass"
      ],
      "priority": 2,
      "passes": false,
      "notes": "Generated by super-loop"
    },
    {
      "id": "US-003",
      "title": "Integration and edge case handling for $feature",
      "description": "As a system operator, I want error handling and full integration tests.",
      "acceptanceCriteria": [
        "End-to-end integration verified",
        "Error cases handled gracefully"
      ],
      "priority": 3,
      "passes": false,
      "notes": "Generated by super-loop"
    }
  ]
}
EOF
    echo "✓ Initialized $prd_file with customized feature breakdown"
  else
    # Update existing prd.json project and branch without wiping existing custom user stories
    local temp_json
    temp_json=$(mktemp)
    jq --arg proj "$feature" --arg b "$branch_name" '.project = $proj | .branchName = $b | .description = $proj' "$prd_file" > "$temp_json" && mv "$temp_json" "$prd_file"
    echo "✓ Updated existing $prd_file with project name '$feature'"
  fi

  # 4. Initialize progress.txt
  local progress_file="scripts/ralph/progress.txt"
  if [ ! -f "$progress_file" ]; then
    cat > "$progress_file" << EOF
# Ralph Progress Log
Project: $feature
Branch: $branch_name
Started: $(date '+%Y-%m-%d %H:%M:%S')

## Codebase Patterns
- Follow standard project conventions, style guidelines, and modular patterns.
- Ensure all tests run cleanly before marking stories passed.

## Iteration History
EOF
    echo "✓ Created $progress_file"
  fi

  # 5. Initialize GSD Planning directory structure
  mkdir -p .planning/phases/01-initial
  local gsd_plan=".planning/phases/01-initial/PLAN.md"
  if [ ! -f "$gsd_plan" ]; then
    cat > "$gsd_plan" << EOF
# GSD Phase Plan: $feature

## Objective
Implement $feature through verified autonomous execution.

## File Boundaries & Contracts
- Types, models, and public interfaces declared upfront
- Implementations strictly match declared contracts

## Acceptance Criteria
- Full test suite passing
- Typechecks and linters clear
EOF
    echo "✓ Initialized GSD architecture plan in $gsd_plan"
  fi

  echo ""
  echo "Pipeline Ready!"
  echo "Next steps:"
  echo "  1. (Optional) Fine-tune user stories in $prd_file or run '/super-loop' in chat for interactive grilling."
  echo "  2. Start unattended autonomous execution:"
  echo "       super-loop --run 15"
}

# --- Command Line Interface ---

if [ $# -eq 0 ]; then
  show_help
  exit 0
fi

# Parse help and version before checking heavy dependencies
case "$1" in
  -h|--help)
    show_help
    exit 0
    ;;
  -v|--version)
    echo "super-loop v$VERSION"
    exit 0
    ;;
esac

# Parse options and dispatch commands
while [[ $# -gt 0 ]]; do
  case "$1" in
    --status)
      cmd_status
      exit 0
      ;;
    --verify)
      cmd_verify
      exit 0
      ;;
    --run)
      shift
      cmd_run "${1:-$DEFAULT_ITERATIONS}"
      exit 0
      ;;
    --tool)
      TOOL="$2"
      shift 2
      ;;
    --model)
      MODEL="$2"
      shift 2
      ;;
    --iterations)
      DEFAULT_ITERATIONS="$2"
      shift 2
      ;;
    -*)
      echo "Unknown option: $1"
      show_help
      exit 1
      ;;
    *)
      # Assume argument is feature prompt
      cmd_init "$1"
      exit 0
      ;;
  esac
done
